import React, { useState, useEffect } from "react";
import { Input, Button, Typography, Progress } from "antd";
import { CloseOutlined, CheckOutlined } from "@ant-design/icons";
import { useNavigate } from "react-router-dom";
import { db } from "../../firebase";
import {
  collection,
  query,
  where,
  getDocs,
  getDoc,
  doc,
  updateDoc
} from "firebase/firestore";
import "./Rsvp.css";

const { Title } = Typography;

// Define a custom order for events.
const eventOrder = [
  "HernishaMehndi",
  "HernishaPithi",
  "DhruvPithi",
  "Sangeet",
  "WeddingCeremony",
  "AfterParty"
];

const Rsvp = () => {
  // Step 1: Access code input; Steps 2+ are event pages.
  const [step, setStep] = useState(1);
  const [accessCode, setAccessCode] = useState("");
  const [familyMembers, setFamilyMembers] = useState([]); // Array of user documents for this family.
  const [filteredEvents, setFilteredEvents] = useState([]); // Sorted events for which at least one family member is invited.
  // Local RSVP responses: { eventId: { userId: "Yes" | "No" | "pending" } }
  const [rsvpResponses, setRsvpResponses] = useState({});
  const [allEvents, setAllEvents] = useState([]);
  const navigate = useNavigate();

  // Fetch all events from Firestore on mount.
  useEffect(() => {
    const fetchAllEvents = async () => {
      try {
        const eventsSnapshot = await getDocs(collection(db, "events"));
        const eventsArr = eventsSnapshot.docs.map(doc => ({
          id: doc.id,
          ...doc.data()
        }));
        setAllEvents(eventsArr);
      } catch (error) {
        console.error("Error fetching events:", error);
      }
    };
    fetchAllEvents();
  }, []);

  // When on an event page (step>=2), re-read the RSVP responses from Firestore
  // for the current event and update local state.
  useEffect(() => {
    const fetchEventRsvp = async () => {
      if (step < 2 || filteredEvents.length === 0) return;
      const currentEvent = filteredEvents[step - 2];
      try {
        const eventRef = doc(db, "events", currentEvent.id);
        const eventSnap = await getDoc(eventRef);
        if (eventSnap.exists()) {
          const data = eventSnap.data();
          let newResponses = {};
          // data.rsvpList is an object mapping userName -> "Yes" or "No"
          if (data.rsvpList) {
            familyMembers.forEach(member => {
              if (data.rsvpList[member.name]) {
                newResponses[member.id] = data.rsvpList[member.name];
              }
            });
          }
          setRsvpResponses(prev => ({
            ...prev,
            [currentEvent.id]: newResponses
          }));
        }
      } catch (error) {
        console.error("Error fetching event RSVP responses:", error);
      }
    };
    fetchEventRsvp();
  }, [step, filteredEvents, familyMembers]);

  // Validate the access code, fetch family members, and filter events.
  const handleValidateAccessCode = async () => {
    if (!accessCode) {
      alert("Please enter an access code.");
      return;
    }
    try {
      // Query families collection.
      const familyQuery = query(
        collection(db, "families"),
        where("accessCode", "==", accessCode)
      );
      const familySnapshot = await getDocs(familyQuery);
      if (familySnapshot.empty) {
        alert("Invalid access code.");
        return;
      }
      const familyDoc = familySnapshot.docs[0];
      const familyData = familyDoc.data();
      const memberIds = familyData.members || [];
      if (memberIds.length === 0) {
        alert("No family members found for this access code.");
        return;
      }
      // Fetch family members from users collection using an "in" query.
      const usersQuery = query(
        collection(db, "users"),
        where("__name__", "in", memberIds)
      );
      const usersSnapshot = await getDocs(usersQuery);
      const members = usersSnapshot.docs.map(doc => ({
        id: doc.id,
        ...doc.data()
      }));
      setFamilyMembers(members);

      // Filter events: keep only those events where at least one family member
      // has that event ID in their 'events' array.
      const familyMemberIds = members.map(m => m.id);
      const relevantEvents = allEvents.filter(event =>
        members.some(member => member.events && member.events.includes(event.id))
      );
      if (relevantEvents.length === 0) {
        alert("None of your family members are invited to any events.");
        return;
      }
      // Sort events using the custom eventOrder.
      const sortedEvents = relevantEvents.sort((a, b) => {
        return eventOrder.indexOf(a.id) - eventOrder.indexOf(b.id);
      });
      setFilteredEvents(sortedEvents);

      // Initialize RSVP responses for each event (only for invited members).
      const initialResponses = {};
      sortedEvents.forEach(event => {
        initialResponses[event.id] = {};
        members.forEach(member => {
          if (member.events && member.events.includes(event.id)) {
            initialResponses[event.id][member.id] = "pending";
          }
        });
      });
      setRsvpResponses(initialResponses);

      // Move to the first event page (Step 2).
      setStep(2);
    } catch (error) {
      console.error("Error validating access code:", error);
      alert("Error fetching data. Please try again.");
    }
  };

  // Handler for Accept/Decline button clicks.
  const handleResponse = async (eventId, userId, response) => {
    const rsvpValue = response === "accept" ? "Yes" : "No";
    // Update local state.
    setRsvpResponses(prev => ({
      ...prev,
      [eventId]: {
        ...prev[eventId],
        [userId]: rsvpValue
      }
    }));
    try {
      // Update user's document.
      const userRef = doc(db, "users", userId);
      await updateDoc(userRef, {
        [`rsvp.${eventId}`]: rsvpValue
      });
      console.log(`User ${userId} RSVP for ${eventId} updated to ${rsvpValue}`);
    } catch (error) {
      console.error("Error updating user RSVP:", error);
    }
    try {
      // Update event's document, using user's name instead of ID.
      const member = familyMembers.find(m => m.id === userId);
      const userName = member ? member.name : userId;
      const eventRef = doc(db, "events", eventId);
      await updateDoc(eventRef, {
        [`rsvpList.${userName}`]: rsvpValue
      });
      console.log(`Event ${eventId} RSVPList updated for ${userName} to ${rsvpValue}`);
    } catch (error) {
      console.error("Error updating event RSVPList:", error);
    }
  };

  // Navigation handlers.
  const handleNext = () => {
    if (step < 2 + filteredEvents.length - 1) {
      setStep(step + 1);
    } else {
      alert("You have reached the end of your events. Thank you!");
      // Optionally, perform final actions.
    }
  };

  const handleBack = () => {
    if (step > 1) setStep(step - 1);
  };

  const handleClose = () => {
    navigate("/weddinghd");
  };

  // Render the event page for the event at index (step - 2).
  const renderEventPage = (eventObj) => {
    // For this event, only show family members who are invited (i.e. their 'events' array includes eventObj.id).
    const invitedMembers = familyMembers.filter(member =>
      member.events && member.events.includes(eventObj.id)
    );
    return (
      <>
        <Title level={3} className="rsvp-form-titles">{eventObj.title}</Title>
        <p className="rsvp-event-details">
          📅 <strong>{eventObj.date}</strong>
        </p>
        <p className="rsvp-event-details">
          📍 <strong>{eventObj.location}</strong>{" "}
          <a href="#">View Full Address</a>
        </p>
        <div className="rsvp-guests-container">
          {invitedMembers.length > 0 ? (
            invitedMembers.map(member => (
              <div key={member.id} className="rsvp-guest">
                <p className="rsvp-guest-name">{member.name}</p>
                <div className="rsvp-options">
                  <Button
                    className={`rsvp-option-button accept ${rsvpResponses[eventObj.id]?.[member.id] === "Yes" ? "selected" : ""}`}
                    onClick={() => handleResponse(eventObj.id, member.id, "accept")}
                  >
                    Accept {rsvpResponses[eventObj.id]?.[member.id] === "Yes" && <CheckOutlined style={{ marginLeft: 8 }} />}
                  </Button>
                  <Button
                    className={`rsvp-option-button decline ${rsvpResponses[eventObj.id]?.[member.id] === "No" ? "selected" : ""}`}
                    onClick={() => handleResponse(eventObj.id, member.id, "decline")}
                  >
                    Decline {rsvpResponses[eventObj.id]?.[member.id] === "No" && <CheckOutlined style={{ marginLeft: 8 }} />}
                  </Button>
                </div>
              </div>
            ))
          ) : (
            <p>No family members are invited to this event.</p>
          )}
        </div>
        <div className="rsvp-buttons">
          <Button className="rsvp-back" onClick={handleBack}>Back</Button>
          <Button type="primary" className="rsvp-continue-button" onClick={handleNext}>
            {step < 2 + filteredEvents.length - 1 ? "Next" : "Finish"}
          </Button>
        </div>
      </>
    );
  };

  // Total steps = 1 (access code page) + number of event pages.
  const totalSteps = 1 + filteredEvents.length;

  return (
    <div className="rsvp-container">
      <div className="rsvp-header">
        <Progress
          percent={(step / totalSteps) * 100}
          showInfo={false}
          className="rsvp-progress"
          trailColor="rgb(233,233,237)"
          strokeColor="rgb(126,116,115)"
        />
        <CloseOutlined className="rsvp-exit" onClick={handleClose} />
      </div>

      {step === 1 && (
        <div className="access-code-step">
        <h1 className="rsvp-title">Hernisha & Dhruv's Wedding</h1>
          <Title level={2} className="rsvp-form-title">Enter Your Access Code</Title>
          <Input
            placeholder="Access Code"
            maxLength={10}
            value={accessCode}
            onChange={(e) => setAccessCode(e.target.value)}
            className="rsvp-input"
          />
          <Button
            type="primary"
            className="rsvp-continue-button"
            keyboardType='number-pad'
            onClick={handleValidateAccessCode}
          >
            Find Your Invitation
          </Button>
        </div>
      )}

      {step >= 2 && filteredEvents.length > 0 && renderEventPage(filteredEvents[step - 2])}
    </div>
  );
};

export default Rsvp;
